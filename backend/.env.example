# Server Configuration
PORT=3002
NODE_ENV=development

# ============================================
# Database Configuration (Choose ONE)
# ============================================
# Without a cloud database, data will be lost on each server restart (Render uses ephemeral filesystem)
# You only need to configure ONE of the following options.

# Local LowDB memory deletion receipts must survive user JSON snapshot recovery.
# Set an ABSOLUTE, durable path outside the user JSON backup/restore set in deployment.
# Empty uses DATA_DIR/memory-deletions. This adapter is single-process only.
# MongoDB/PostgreSQL memory APIs return 503 until a durable deletion ledger is implemented.
MEMORY_DELETION_DIR=
# A verified empty local auth/user store initializes its registry on first startup.
# Existing installations with a missing registry require an audited migration.

# --- Option A: Supabase (RECOMMENDED - Easiest) ---
# 1. Go to https://supabase.com and sign up (just email, no Google needed)
# 2. Create a new project (free, takes 30 seconds)
# 3. Go to Project Settings > Database > Connection string > URI
# 4. Copy the connection string and replace [YOUR-PASSWORD] with your database password
# SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxx.supabase.co:5432/postgres

# --- Option B: MongoDB Atlas ---
# Get your free MongoDB Atlas connection string at: https://www.mongodb.com/atlas
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/
# MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/
# MONGODB_DB_NAME=qunthink

# Authentication Configuration
# AUTH_MODE: session is the supported Web flow. dev uses an untrusted
# x-user-id header and does not provision the durable source-deletion ledger.
# Use session accounts for message, memory, search, social and TTS testing.
AUTH_MODE=session
# Server-owned provider keys are never shared with user catalogs by default.
# Keep disabled until an operator explicitly funds use; account-level cost
# reservation and settlement are not implemented yet.
QUNTHINK_SHARED_PROVIDER_KEYS=0
# Session max age in milliseconds (default: 2592000000 = 30 days)
SESSION_MAX_AGE=2592000000

# API Keys
# Optional legacy presets. Any provider/model can be added in the model center.
DEEPSEEK_API_KEY=
GLM_API_KEY=
MIMO_API_KEY=
QWEN_API_KEY=
# Exact origins allowed for private/local model services, controlled by the server.
# Example: AI_ALLOWED_LOCAL_ORIGINS=http://127.0.0.1:11434
AI_ALLOWED_LOCAL_ORIGINS=
# Off by default: health probes can consume provider credits.
AI_HEALTH_PROBES=0
# Per-user daily manual + scheduled task execution limit.
TASK_DAILY_RUN_LIMIT=24

# Only the explicitly authorized, zero-cost personal goal brief action.
# Requires QUNTHINK_FOUNDATIONS_RUNTIME_URL and applied foundation migrations.
# Disabled by default; this is not a general Agent or external-tool worker.
# QUNTHINK_FOUNDATIONS_RUNTIME_URL=postgresql://<runtime-role>:<password>@<host>:5432/<db>
# QUNTHINK_FOUNDATIONS_SCHEMA=qunthink_core
QUNTHINK_GOAL_BRIEF_SCHEDULER=0
QUNTHINK_GOAL_BRIEF_POLL_MS=10000
QUNTHINK_GOAL_BRIEF_USERS_PER_TICK=100
QUNTHINK_GOAL_BRIEF_RUNS_PER_USER=10

# Encryption Key (REQUIRED in production)
# Must be a base64-encoded 32-byte random secret. Generate with:
#   openssl rand -base64 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Production: Must set this environment variable, otherwise the application will not start
# Development: If not set, will use file-based key stored in backend/data/.encryption_key
# ⚠️  NEVER commit .env file or .encryption_key file to version control
# ⚠️  Key rotation will invalidate previously encrypted data
ENCRYPTION_KEY=

# Aliyun SMS Configuration
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# CORS Configuration
CORS_ORIGINS=http://localhost:3010,http://127.0.0.1:3010
